[Unit]
Description=Sprenses denetim otomasyonu zamanlayıcı (5 saatte bir, Istanbul)

[Timer]
# 5 saatte bir: 00:40, 05:40, 10:40, 15:40, 20:40 (Europe/Istanbul).
# 24 saat 5'e tam bölünmediğinden gün sonundaki boşluk 4 saattir — kabul edilir.
# Dakika :40 seçildi: Sedna (:15) ve satış senkronu (:15) çalışırken başlamasın;
# eşzamanlı iş EC2'de 4 GB RAM'i zorlar (docs/modules/sunucu.md, 2026-07-06/18 olayları).
OnCalendar=*-*-* 00/5:40:00 Europe/Istanbul
# Sunucu kapalıyken kaçan koşu açılışta telafi edilir
Persistent=true
# Diğer timer'larla aynı saniyede tetiklenmesin
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
